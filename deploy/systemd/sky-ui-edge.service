[Unit]
Description=Sky UI HTTPS and owner authentication
After=network-online.target sky-ui.service
Wants=network-online.target

[Service]
LogNamespace=sky-ui
Type=notify
NotifyAccess=main
User=sky-ui-edge
Group=sky-ui-edge
Environment=XDG_DATA_HOME=/var/lib/sky-ui-edge/data
Environment=XDG_CONFIG_HOME=/var/lib/sky-ui-edge/config
ExecStart=/opt/sky-ui/current/bin/caddy run --config /etc/sky-ui/Caddyfile --adapter caddyfile
ExecReload=/opt/sky-ui/current/bin/caddy reload --address unix//run/sky-ui-edge/admin.sock --config /etc/sky-ui/Caddyfile --adapter caddyfile
TimeoutStopSec=5
Restart=on-failure
RestartSec=3
StateDirectory=sky-ui-edge
StateDirectoryMode=0700
RuntimeDirectory=sky-ui-edge
RuntimeDirectoryMode=0700
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/sky-ui-edge /run/sky-ui-edge
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
