[Unit]
Description=Sky UI managed mihomo instance
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=sky-ui-core
Group=sky-ui
WorkingDirectory=/var/lib/sky-ui/cores/mihomo
ExecStartPre=/opt/sky-ui/current/bin/mihomo -t -d /var/lib/sky-ui/cores/mihomo -f /var/lib/sky-ui/cores/mihomo/config.yaml
ExecStart=/opt/sky-ui/current/bin/mihomo -d /var/lib/sky-ui/cores/mihomo -f /var/lib/sky-ui/cores/mihomo/config.yaml
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/sky-ui/cores/mihomo
# UDP route/interface discovery uses netlink; CAP_NET_ADMIN remains absent.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
