[Unit]
Description=Sky UI interrupted maintenance recovery
DefaultDependencies=no
After=local-fs.target
Before=sky-ui.service sky-ui-mihomo.service sky-ui-sing-box.service sky-ui-xray.service sky-ui-amneziawg.service sky-ui-edge.service
ConditionPathExists=/var/lib/sky-ui-maintenance

[Service]
LogNamespace=sky-ui
Type=oneshot
ExecStart=/opt/sky-ui/current/bin/sky-ops maintenance --recover
RemainAfterExit=yes
UMask=0077

[Install]
WantedBy=multi-user.target
