[Unit]
Description=Sky UI managed Xray
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=sky-ui-xray
Group=sky-ui
WorkingDirectory=/var/lib/sky-ui/cores/xray
ExecStartPre=/opt/sky-ui/cores/xray/current/xray run -test -config /var/lib/sky-ui/cores/xray/config.json
ExecStart=/opt/sky-ui/cores/xray/current/xray run -config /var/lib/sky-ui/cores/xray/config.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/sky-ui/cores/xray
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
