[Unit]
Description=Sky UI storage cleanup
After=local-fs.target
ConditionPathExists=/etc/sky-ui/managed-by-sky-ui

[Service]
Type=oneshot
ExecStart=/opt/sky-ui/current/bin/sky-ops storage
ExecStopPost=/usr/bin/rm -f /var/lib/sky-ui-maintenance/cleanup-intent.json
TimeoutStartSec=120
UMask=0077
ProtectHome=yes
ProtectSystem=strict
NoNewPrivileges=yes
ReadWritePaths=/opt/sky-ui/releases /opt/sky-ui/cores /var/lib/sky-ui-maintenance /run/lock /var/tmp
ReadWritePaths=-/var/cache/sky-ui-install
RestrictAddressFamilies=AF_UNIX
MemoryMax=96M
MemorySwapMax=0
CPUQuota=25%
TasksMax=32
Nice=19
IOSchedulingClass=idle
LogNamespace=sky-ui
