[Unit]
Description=Sky UI validated TLS certificate publisher
After=sky-ui-edge.service
ConditionPathExists=/etc/sky-ui/access.conf

[Service]
LogNamespace=sky-ui
Type=oneshot
ExecStart=/opt/sky-ui/current/bin/sky-ops certificates-sync
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/sky-ui-certificates
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_CHOWN
