[Unit]
Description=Sky UI server panel
After=network.target sky-ui-systemd-control.socket
Requires=sky-ui-systemd-control.socket
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
LogNamespace=sky-ui
Type=simple
User=sky-ui
Group=sky-ui
WorkingDirectory=/var/lib/sky-ui
EnvironmentFile=/etc/sky-ui/server.env
Environment=SKY_UI_SYSTEMD_CONTROL_SOCKET=/run/sky-ui-systemd-control.sock
ExecStart=/opt/sky-ui/current/bin/sky-ui
Restart=on-failure
RestartSec=3
StateDirectory=sky-ui
StateDirectoryMode=0750
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/sky-ui /var/lib/sky-ui-maintenance/inbox
# Read interface addresses through libc/getifaddrs; no network capabilities.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
