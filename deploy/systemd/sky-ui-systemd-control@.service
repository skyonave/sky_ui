[Unit]
Description=Sky UI managed systemd operation
PartOf=sky-ui-systemd-control.socket

[Service]
LogNamespace=sky-ui
ExecStart=/opt/sky-ui/current/bin/sky-ops systemd-control
StandardInput=socket
StandardOutput=inherit
StandardError=journal
RuntimeMaxSec=20s
TimeoutStopSec=2s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
