[Unit]
Description=Sky UI panel update
After=network-online.target
Wants=network-online.target
OnFailure=sky-ui-update-recovery.service

[Service]
LogNamespace=sky-ui
Type=oneshot
ExecStopPost=-/usr/bin/systemctl start --no-block sky-ui-cleanup.service
ExecStart=/opt/sky-ui/current/bin/sky-ops panel-update
TimeoutStartSec=2100
UMask=0077
PrivateTmp=yes
ProtectHome=yes
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/sky-ui /etc/sky-ui /etc/systemd/system -/etc/polkit-1/rules.d /usr/local/bin /var/lib/sky-ui /var/lib/sky-ui-maintenance /var/lib/sky-ui-edge /var/lib/sky-ui-certificates /run/lock
ReadWritePaths=-/var/cache/sky-ui-install
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
