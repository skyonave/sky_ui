[Unit]
Description=Sky UI panel update
After=network-online.target
Wants=network-online.target
OnFailure=sky-ui-update-recovery.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/sky-ui/current/deploy/panel_update.py
TimeoutStartSec=600
UMask=0077
PrivateTmp=yes
ProtectHome=yes
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/opt/sky-ui /etc/sky-ui /etc/systemd/system /etc/polkit-1/rules.d /usr/local/bin /var/lib/sky-ui /var/lib/sky-ui-maintenance /var/lib/sky-ui-edge /var/lib/sky-ui-certificates /run/lock
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
