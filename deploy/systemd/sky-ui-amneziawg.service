[Unit]
Description=Sky UI managed AmneziaWG 3.1 interfaces
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
User=root
Group=sky-ui
WorkingDirectory=/var/lib/sky-ui/cores/amneziawg
ExecStartPre=/usr/bin/python3 -I /opt/sky-ui/current/deploy/amnezia_network.py check /var/lib/sky-ui/cores/amneziawg/config.json
ExecStart=/usr/bin/python3 -I /opt/sky-ui/current/deploy/amnezia_network.py run /var/lib/sky-ui/cores/amneziawg/config.json /opt/sky-ui/cores/amneziawg/current/amneziawg
ExecStopPost=/usr/bin/python3 -I /opt/sky-ui/current/deploy/amnezia_network.py cleanup
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/sky-ui-amneziawg-network /run/amneziawg
RuntimeDirectory=amneziawg
RuntimeDirectoryMode=0700
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
