[Unit]
Description=Sky UI managed sing-box
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
LogNamespace=sky-ui
Type=simple
User=sky-ui-sing-box
Group=sky-ui
WorkingDirectory=/var/lib/sky-ui/cores/sing-box
ExecStartPre=/opt/sky-ui/cores/sing-box/current/sing-box check -c /var/lib/sky-ui/cores/sing-box/config.json
ExecStart=/opt/sky-ui/cores/sing-box/current/sing-box run -c /var/lib/sky-ui/cores/sing-box/config.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=10
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/sky-ui/cores/sing-box
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
