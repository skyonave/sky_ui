// Authorize only the dedicated managed unit and lifecycle verbs.
polkit.addRule(function(action, subject) {
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        subject.user === "sky-ui" &&
        ["sky-ui-maintenance.service", "sky-ui-update.service"].indexOf(action.lookup("unit")) !== -1 &&
        action.lookup("verb") === "start") {
        return polkit.Result.YES;
    }
    if (action.id === "org.freedesktop.systemd1.manage-units" &&
        subject.user === "sky-ui" &&
        ["sky-ui-mihomo.service", "sky-ui-sing-box.service", "sky-ui-xray.service", "sky-ui-amneziawg.service"].indexOf(action.lookup("unit")) !== -1 &&
        ["start", "stop", "restart", "reset-failed"].indexOf(action.lookup("verb")) !== -1) {
        return polkit.Result.YES;
    }
});
